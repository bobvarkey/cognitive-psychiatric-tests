# Copy to .env and fill in. Only VITE_* values belong here: Vite inlines them into
# the public client bundle. Never put a service-role key or Razorpay secret here.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
